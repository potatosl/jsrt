// Engine-backed brand checks shared by structuredClone and util.types.
//
// JavaScriptCore's C API only exposes brands for typed arrays, arrays and dates. Everything else is
// told apart here by calling an intrinsic that throws a TypeError on any other receiver (for
// example the Map.prototype.size getter), or, for errors, the engine's own Error.isError. Both are
// captured before user code runs, so replacing Map.prototype or forging Symbol.toStringTag cannot
// change the answer. A thrown TypeError means "not that kind"; the exception is discarded here.
import("./context_state")::{owned_context_slot, release_context_slot, BRANDS_SLOT};
import("./values")::{get, capture};
import("./byte_codec")::{encode_bytes};
import("./inspect_engine")::{capture_getter};
import("std::mem::layout")::{size_of};
extern(c, "wr_context_global") fun global(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_undefined") fun undefined(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_type") fun kind(ctx: ptr<u8>, value: ptr<u8>) -> i32;
extern(c, "wr_call") fun call(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_to_boolean") fun truth(ctx: ptr<u8>, value: ptr<u8>) -> bool;
extern(c, "wr_protect") fun protect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_unprotect") fun unprotect(ctx: ptr<u8>, value: ptr<u8>);

const TYPE_OBJECT: i32 = 5;

// Indexes into BrandState.checks.
const CHECK_MAP: i64 = 0;
const CHECK_SET: i64 = 1;
const CHECK_WEAK_MAP: i64 = 2;
const CHECK_WEAK_SET: i64 = 3;
const CHECK_REGEXP: i64 = 4;
const CHECK_PROMISE: i64 = 5;
const CHECK_ERROR: i64 = 6;
// valueOf of each wrapper prototype: it throws a TypeError for anything that is not a real wrapper.
const CHECK_NUMBER_OBJECT: i64 = 7;
const CHECK_STRING_OBJECT: i64 = 8;
const CHECK_BOOLEAN_OBJECT: i64 = 9;
const CHECK_BIGINT_OBJECT: i64 = 10;
const CHECK_SYMBOL_OBJECT: i64 = 11;
const CHECK_DATA_VIEW: i64 = 12;
// Object.prototype.toString and Object.hasOwn, used for the tag-based checks below.
const CHECK_TO_STRING: i64 = 13;
const CHECK_HAS_OWN: i64 = 14;
const CHECK_COUNT: i64 = 15;

struct BrandState {
    checks: array<ptr<u8>, 15>;
    tag_symbol: ptr<u8>;
    // Function.prototype: a callable that returns undefined, passed as the rejection handler of the
    // Promise brand probe so the derived promise never reports a rejection of its own.
    swallow: ptr<u8>;
}

fun storage(ctx: ptr<u8>) -> ptr<BrandState> {
    return owned_context_slot(ctx, BRANDS_SLOT, size_of<BrandState>() as i64) as ptr<BrandState>;
}

// Calls checks[index] with `value` as the receiver. getter_style checks (size, source) take no
// argument; method-style checks (has, then) take one throwaway argument.
fun passes(ctx: ptr<u8>, index: i64, value: ptr<u8>, argument: bool) -> bool {
    if (kind(ctx, value) != TYPE_OBJECT) {
        return false;
    }
    var state: ptr<BrandState> = storage(ctx);
    var check: ptr<u8> = (deref state.checks)[index];
    if (check == null) {
        return false;
    }
    var discarded: ptr<u8> = null;
    var count: i64 = 0;
    var probe: array<ptr<u8>, 1> = [value];
    if (argument) {
        count = 1;
    }
    call(ctx, check, value, count, &probe[0], &discarded);
    return discarded == null;
}

pub fun is_map(ctx: ptr<u8>, value: ptr<u8>) -> bool {
    return passes(ctx, CHECK_MAP, value, false);
}

pub fun is_set(ctx: ptr<u8>, value: ptr<u8>) -> bool {
    return passes(ctx, CHECK_SET, value, false);
}

pub fun is_weak_map(ctx: ptr<u8>, value: ptr<u8>) -> bool {
    return passes(ctx, CHECK_WEAK_MAP, value, true);
}

pub fun is_weak_set(ctx: ptr<u8>, value: ptr<u8>) -> bool {
    return passes(ctx, CHECK_WEAK_SET, value, true);
}

pub fun is_regexp(ctx: ptr<u8>, value: ptr<u8>) -> bool {
    return passes(ctx, CHECK_REGEXP, value, false);
}

// Promise.prototype.then is only used for its brand check. The derived promise it returns would
// report a rejection of the probed promise as unhandled, so a no-op rejection handler is attached.
pub fun is_promise(ctx: ptr<u8>, value: ptr<u8>) -> bool {
    if (kind(ctx, value) != TYPE_OBJECT) {
        return false;
    }
    var state: ptr<BrandState> = storage(ctx);
    var check: ptr<u8> = (deref state.checks)[CHECK_PROMISE];
    if (check == null || deref state.swallow == null) {
        return false;
    }
    var discarded: ptr<u8> = null;
    var handlers: array<ptr<u8>, 2> = [undefined(ctx), deref state.swallow];
    call(ctx, check, value, 2, &handlers[0], &discarded);
    return discarded == null;
}

// Error.isError is the engine's brand check: it accepts real error objects (including subclasses)
// and rejects Object.create(Error.prototype) and objects that only claim the Error tag.
pub fun is_native_error(ctx: ptr<u8>, value: ptr<u8>) -> bool {
    if (kind(ctx, value) != TYPE_OBJECT) {
        return false;
    }
    var state: ptr<BrandState> = storage(ctx);
    var check: ptr<u8> = (deref state.checks)[CHECK_ERROR];
    if (check == null) {
        return false;
    }
    var discarded: ptr<u8> = null;
    var argument: array<ptr<u8>, 1> = [value];
    var answer: ptr<u8> = call(ctx, check, null, 1, &argument[0], &discarded);
    return discarded == null && answer != null && truth(ctx, answer);
}

pub fun is_number_object(ctx: ptr<u8>, value: ptr<u8>) -> bool {
    return passes(ctx, CHECK_NUMBER_OBJECT, value, false);
}

pub fun is_string_object(ctx: ptr<u8>, value: ptr<u8>) -> bool {
    return passes(ctx, CHECK_STRING_OBJECT, value, false);
}

pub fun is_boolean_object(ctx: ptr<u8>, value: ptr<u8>) -> bool {
    return passes(ctx, CHECK_BOOLEAN_OBJECT, value, false);
}

pub fun is_bigint_object(ctx: ptr<u8>, value: ptr<u8>) -> bool {
    return passes(ctx, CHECK_BIGINT_OBJECT, value, false);
}

pub fun is_symbol_object(ctx: ptr<u8>, value: ptr<u8>) -> bool {
    return passes(ctx, CHECK_SYMBOL_OBJECT, value, false);
}

pub fun install_brands(ctx: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    var state: ptr<BrandState> = storage(ctx);
    var root: ptr<u8> = global(ctx);
    (deref state.checks)[CHECK_MAP] = capture_getter(ctx, "Map", "size", ex);
    (deref state.checks)[CHECK_SET] = capture_getter(ctx, "Set", "size", ex);
    (deref state.checks)[CHECK_REGEXP] = capture_getter(ctx, "RegExp", "source", ex);
    (deref state.checks)[CHECK_WEAK_MAP] = capture(ctx, get(ctx, get(ctx, root, "WeakMap", ex), "prototype", ex), "has", ex);
    (deref state.checks)[CHECK_WEAK_SET] = capture(ctx, get(ctx, get(ctx, root, "WeakSet", ex), "prototype", ex), "has", ex);
    (deref state.checks)[CHECK_PROMISE] = capture(ctx, get(ctx, get(ctx, root, "Promise", ex), "prototype", ex), "then", ex);
    (deref state.checks)[CHECK_DATA_VIEW] = capture_getter(ctx, "DataView", "byteLength", ex);
    var object_ctor: ptr<u8> = get(ctx, root, "Object", ex);
    (deref state.checks)[CHECK_TO_STRING] = capture(ctx, get(ctx, object_ctor, "prototype", ex), "toString", ex);
    (deref state.checks)[CHECK_HAS_OWN] = capture(ctx, object_ctor, "hasOwn", ex);
    deref state.tag_symbol = get(ctx, get(ctx, root, "Symbol", ex), "toStringTag", ex);
    protect(ctx, deref state.tag_symbol);
    deref state.swallow = get(ctx, get(ctx, root, "Function", ex), "prototype", ex);
    protect(ctx, deref state.swallow);
    (deref state.checks)[CHECK_ERROR] = capture(ctx, get(ctx, root, "Error", ex), "isError", ex);
    var wrapper_names: array<str, 5> = ["Number", "String", "Boolean", "BigInt", "Symbol"];
    for (var i: i64 = 0; i < 5; i++) {
        (deref state.checks)[CHECK_NUMBER_OBJECT + i] = capture(ctx, get(ctx, get(ctx, root, wrapper_names[i], ex), "prototype", ex),
            "valueOf", ex);
    }
    for (var i: i64 = 0; i < CHECK_COUNT; i++) {
        if ((deref state.checks)[i] != null) {
            protect(ctx, (deref state.checks)[i]);
        }
    }
    return deref ex == null;
}

pub fun shutdown_brands(ctx: ptr<u8>) {
    var state: ptr<BrandState> = storage(ctx);
    if (state == null) {
        return;
    }
    if (deref state.tag_symbol != null) {
        unprotect(ctx, deref state.tag_symbol);
        deref state.tag_symbol = null;
    }
    if (deref state.swallow != null) {
        unprotect(ctx, deref state.swallow);
        deref state.swallow = null;
    }
    for (var i: i64 = 0; i < CHECK_COUNT; i++) {
        if ((deref state.checks)[i] != null) {
            unprotect(ctx, (deref state.checks)[i]);
            (deref state.checks)[i] = null;
        }
    }
    release_context_slot(ctx, BRANDS_SLOT, size_of<BrandState>() as i64);
}

pub fun is_data_view(ctx: ptr<u8>, value: ptr<u8>) -> bool {
    return passes(ctx, CHECK_DATA_VIEW, value, false);
}

// Compares Object.prototype.toString(value) with "[object <tag>]". Objects that carry their own
// Symbol.toStringTag are rejected (unless `own_tag_allowed`), so a plain object cannot claim the
// tag; real arguments objects, iterators and generators inherit or have no tag property.
fun has_builtin_tag(ctx: ptr<u8>, value: ptr<u8>, tag: str, own_tag_allowed: bool) -> bool {
    if (kind(ctx, value) != TYPE_OBJECT) {
        return false;
    }
    var state: ptr<BrandState> = storage(ctx);
    var describe: ptr<u8> = (deref state.checks)[CHECK_TO_STRING];
    var has_own: ptr<u8> = (deref state.checks)[CHECK_HAS_OWN];
    if (describe == null || has_own == null || deref state.tag_symbol == null) {
        return false;
    }
    var problem: ptr<u8> = null;
    if (!own_tag_allowed) {
        var pair: array<ptr<u8>, 2> = [value, deref state.tag_symbol];
        var owned: ptr<u8> = call(ctx, has_own, null, 2, &pair[0], &problem);
        if (problem != null || owned == null || truth(ctx, owned)) {
            return false;
        }
    }
    var label: ptr<u8> = call(ctx, describe, value, 0, null, &problem);
    if (problem != null || label == null) {
        return false;
    }
    var bytes: array<u8, 64>;
    var count: i64 = encode_bytes(ctx, label, 0, &bytes[0], 63, &problem);
    if (count < 0 || problem != null) {
        return false;
    }
    var wanted: ptr<u8> = tag as ptr<u8>;
    var i: i64 = 0;
    while (wanted[i] != 0) {
        if (i >= count || bytes[i + 8] != wanted[i]) {
            return false;
        }
        i += 1;
    }
    // "[object " is eight bytes and the tag is followed by "]".
    return count == i + 9 && bytes[count - 1] == 93;
}

pub fun is_arguments_object(ctx: ptr<u8>, value: ptr<u8>) -> bool {
    return has_builtin_tag(ctx, value, "Arguments", false);
}

pub fun is_generator_object(ctx: ptr<u8>, value: ptr<u8>) -> bool {
    return has_builtin_tag(ctx, value, "Generator", false) || has_builtin_tag(ctx, value, "AsyncGenerator", false);
}

pub fun is_map_iterator(ctx: ptr<u8>, value: ptr<u8>) -> bool {
    return has_builtin_tag(ctx, value, "Map Iterator", false);
}

pub fun is_set_iterator(ctx: ptr<u8>, value: ptr<u8>) -> bool {
    return has_builtin_tag(ctx, value, "Set Iterator", false);
}

pub fun is_generator_function(ctx: ptr<u8>, value: ptr<u8>) -> bool {
    return has_builtin_tag(ctx, value, "GeneratorFunction", false) ||
        has_builtin_tag(ctx, value, "AsyncGeneratorFunction", false);
}

pub fun is_async_function(ctx: ptr<u8>, value: ptr<u8>) -> bool {
    return has_builtin_tag(ctx, value, "AsyncFunction", false) ||
        has_builtin_tag(ctx, value, "AsyncGeneratorFunction", false);
}

// Module namespace objects carry their own Symbol.toStringTag ("Module").
pub fun is_module_namespace_object(ctx: ptr<u8>, value: ptr<u8>) -> bool {
    return has_builtin_tag(ctx, value, "Module", true);
}
